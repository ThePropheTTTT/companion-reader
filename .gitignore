.fake-ai/

# 浏览器自检用的临时 profile（tools/smoke.mjs 会自己清，异常退出时会留下）
.edge-profile*/
.peidu-edge-profile*/

# 参考项目（只读，用于设计参考，不进产品）
_ref/

# 我自己的提交信息草稿（用 git commit -F 时落下的）
.commit-msg.txt

